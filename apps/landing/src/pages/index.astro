                  <span class="app-label sm"></span>
                  <span class="app-input short"></span>
                  <span class="app-btn">Generate Script &amp; Keywords</span>
                </div>
              </div>
              <div class="app-preview">
                <div class="phone">
                  <div class="phone-glow"></div>
                  <span class="caption">5 morning habits that boost focus</span>
                </div>
                <span class="spec"></span>
                <span class="spec"></span>
                <span class="app-gen">Generate Video</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Integrations strip -->
      <section class="wrap strip reveal">
        <span class="strip-label">Works with</span>
        <div class="strip-items">
          {integrations.map((name) => <span class="chip">{name}</span>)}
        </div>
      </section>

      <!-- Features -->
      <section id="features" class="wrap section">
        <div class="section-head reveal">
          <span class="kicker">Features</span>
          <h2>Everything you need to ship Shorts</h2>
          <p>From script to publish — one tool does it all. No subscriptions, no per-video fees.</p>
        </div>
        <div class="bento">
          <article class="card feature-hero reveal">
            <div class="feature-ic">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            </div>
            <h3>Renders on your machine</h3>
            <p>ffmpeg + MoviePy run locally. No render queues, no per-video server fees, and your footage never leaves your computer.</p>
            <div class="feature-meta">
              <span><b>100%</b> local</span>
              <span><b>0</b> server fees</span>
              <span><b>∞</b> renders</span>
