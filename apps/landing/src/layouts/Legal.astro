---
const { title, updated } = Astro.props;
const REPO = "https://github.com/pin705/MoneyPrinterTurbo";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — MoneyPrinter Studio</title>
    <meta name="robots" content="index,follow" />
    <meta name="description" content={`${title} for MoneyPrinter Studio.`} />
    <style>
      :root {
        --ink: #0f1115;
        --muted: #5b6472;
        --line: #e6e8ec;
        --brand: #4f46e5;
        --bg: #fff;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font: 16px/1.7 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--brand); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .wrap { max-width: 760px; margin: 0 auto; padding: 0 22px; }
      header.nav { border-bottom: 1px solid var(--line); }
      .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 60px; }
      .brand { font-weight: 600; color: var(--ink); }
      .brand b { color: var(--brand); }
      main { padding: 40px 0 64px; }
      h1 { font-size: 30px; letter-spacing: -0.02em; margin: 0 0 4px; }
      .updated { color: var(--muted); font-size: 13px; margin: 0 0 8px; }
      .note {
        background: #f7f8fa; border: 1px solid var(--line); border-radius: 10px;
        padding: 12px 16px; font-size: 13.5px; color: var(--muted); margin: 18px 0 28px;
      }
      h2 { font-size: 18px; margin: 30px 0 8px; }
      p, li { color: #2b313c; }
      footer { border-top: 1px solid var(--line); color: var(--muted); font-size: 13px; }
      .foot-inner { display: flex; gap: 18px; flex-wrap: wrap; height: 56px; align-items: center; }
    </style>
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href="/">✦ MoneyPrinter <b>Studio</b></a>
        <a href="/">← Home</a>
      </div>
    </header>
    <main class="wrap">
      <h1>{title}</h1>
      <p class="updated">Last updated: {updated}</p>
      <div class="note">
        This is a starting template. Have it reviewed by legal counsel before
        relying on it for your jurisdiction.
      </div>
      <slot />
    </main>
    <footer>
      <div class="wrap foot-inner">
        <a href="/terms">Terms</a>
        <a href="/privacy">Privacy</a>
        <a href="/refund">Refund</a>
        <a href={REPO}>Source</a>
      </div>
    </footer>
  </body>
</html>
