---
const { title, updated } = Astro.props;
const REPO = "https://github.com/pin705/MoneyPrinterTurbo";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — Vidova</title>
    <meta name="robots" content="index,follow" />
    <meta name="description" content={`${title} for Vidova.`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #08090b;
        --fg: #f5f5f6;
        --fg-2: #a6a7ad;
        --fg-3: #71727a;
        --line: rgba(255, 255, 255, 0.08);
        --brand: #f5f5f6;
        --font: "Geist", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font: 16px/1.7 var(--font);
        letter-spacing: -0.011em;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      a { color: var(--brand); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .wrap { max-width: 740px; margin: 0 auto; padding: 0 24px; }
      header.nav {
        border-bottom: 1px solid var(--line);
        background: rgba(8, 9, 11, 0.72);
        backdrop-filter: blur(14px) saturate(160%);
        position: sticky; top: 0; z-index: 10;
      }
      .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 60px; }
      .brand { display: inline-flex; align-items: center; gap: 9px; color: var(--fg); font-weight: 600; letter-spacing: -0.02em; }
      .logo-icon { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 8px; background: linear-gradient(145deg, #f5f5f6, #d4d4d8); }
      .brand b { color: var(--brand); font-weight: 600; }
      .back { color: var(--fg-2); font-size: 14px; }
      .back:hover { color: var(--fg); text-decoration: none; }
      main { padding: 48px 0 72px; }
      h1 { font-size: 32px; font-weight: 600; letter-spacing: -0.03em; margin: 0 0 6px; }
      .updated { color: var(--fg-3); font-size: 13px; margin: 0 0 10px; }
      .note {
        background: rgba(255, 255, 255, 0.03); border: 1px solid var(--line); border-radius: 12px;
        padding: 14px 18px; font-size: 13.5px; color: var(--fg-2); margin: 20px 0 32px;
      }
      h2 { font-size: 19px; font-weight: 600; letter-spacing: -0.02em; margin: 34px 0 10px; }
      p, li { color: var(--fg-2); }
      strong { color: var(--fg); }
      footer { border-top: 1px solid var(--line); color: var(--fg-3); font-size: 13px; }
      .foot-inner { display: flex; gap: 20px; flex-wrap: wrap; height: 60px; align-items: center; }
      .foot-inner a { color: var(--fg-3); }
      .foot-inner a:hover { color: var(--fg); text-decoration: none; }
    </style>
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href="/">
          <span class="logo-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 28 28" fill="none">
              <path d="M8 13L12.5 9L17 13L21 9" stroke="#09090b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M8 18.5L12.5 14.5L17 18.5L21 14.5" stroke="#09090b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" opacity="0.55"/>
            </svg>
          </span>
          Vid<b>ova</b>
        </a>
        <a class="back" href="/">← Back home</a>
      </div>
    </header>
    <main class="wrap">
      <h1>{title}</h1>
      <p class="updated">Last updated: {updated}</p>
      <div class="note">
        This is a starting template. Have it reviewed by legal counsel before
        relying on it for your jurisdiction.
      </div>
      <slot />
    </main>
    <footer>
      <div class="wrap foot-inner">
        <a href="/terms">Terms</a>
        <a href="/privacy">Privacy</a>
        <a href="/refund">Refund</a>
        <a href={REPO}>Source</a>
      </div>
    </footer>
  </body>
</html>
