# Database (Postgres in prod; omit for local sqlite dev)
DATABASE_URL=postgresql://user:pass@localhost:5432/moneyprinter

# Auth (Supabase project JWT secret; or swap auth.py for Clerk/Auth0 JWKS)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
JWT_ALG=HS256
SIGNUP_CREDIT_GRANT=20

# Managed LLM (server-side only — NEVER ship this in the desktop app)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
CREDITS_PER_CALL=1

# Payments webhook (PayOS / VNPay / Stripe)
PAYMENT_WEBHOOK_SECRET=your-webhook-signing-secret

# CORS (the desktop app origin / tauri)
CORS_ALLOWED_ORIGINS=*
