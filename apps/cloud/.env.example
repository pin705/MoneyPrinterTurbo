# Database (Postgres in prod; omit for local sqlite dev)
DATABASE_URL=postgresql://user:pass@localhost:5432/moneyprinter

# Auth (Supabase project JWT secret; or swap auth.py for Clerk/Auth0 JWKS)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
JWT_ALG=HS256
SIGNUP_CREDIT_GRANT=20

# Managed LLM (server-side only — NEVER ship this in the desktop app)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
CREDITS_PER_CALL=1

# Local/dev auth — accept dev:<uid>:<email> tokens so the app runs without a
# Supabase project. NEVER set this in production.
AUTH_DEV_MODE=0

# SePay (bank-transfer payments). The webhook authenticates with an API key you
# set in the SePay dashboard; SePay sends `Authorization: Apikey <key>`.
SEPAY_WEBHOOK_API_KEY=your-sepay-webhook-api-key
# Merchant bank account that builds the VietQR shown at checkout.
SEPAY_ACCOUNT=0123456789
SEPAY_BANK=MBBank
ORDER_TTL_MINUTES=60

# CORS — explicit allowlist of the web + desktop origins (NOT "*" in prod).
CORS_ALLOWED_ORIGINS=https://vidova-web.vercel.app,tauri://localhost
