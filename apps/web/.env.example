# Copy to .env.local and fill in. All VITE_* vars are baked into the build.

# Supabase auth (Project Settings → API). When BOTH are set, the app uses real
# Supabase auth (email/password + email confirmation + Google). When unset, it
# falls back to a dev sign-in (local/e2e).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Backends
VITE_CLOUD_BASE_URL=http://127.0.0.1:8787   # accounts/credits/billing (apps/cloud)
VITE_API_BASE_URL=http://127.0.0.1:8000      # local render backend (apps/render)

# --- Supabase project setup (one-time, in the dashboard) ---
# Authentication → Providers → Email: enable "Confirm email".
# Authentication → Providers → Google: enable + add OAuth client ID/secret.
# Authentication → URL Configuration: set Site URL + add this app's origin to
#   "Redirect URLs" (e.g. http://localhost:5173 and your production origin).
# The cloud backend must share the project's JWT secret (SUPABASE_JWT_SECRET).
