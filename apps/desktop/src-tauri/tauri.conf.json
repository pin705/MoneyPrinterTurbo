{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vidova",
  "version": "0.1.0",
  "identifier": "app.vidova.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @mpt/web dev",
    "beforeBuildCommand": "pnpm --filter @mpt/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Vidova",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/mpt-backend"],
    "resources": [],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/pin705/MoneyPrinterTurbo/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2QTk5QUUxN0VERkMxRjQKUldUMHdkOSs0WnFwMWtBN2xUZDdDOWZTQ3lrYmo5V1NzVFBPbTVCMFozK0ViS1JBSklLNDFxK3gK"
    }
  }
}
