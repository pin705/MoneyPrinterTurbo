{
  "name": "vidova",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:all": "bash scripts/dev.sh",
    "dev:web": "turbo run dev --filter=@mpt/web",
    "build": "turbo run build --filter=!@mpt/desktop",
    "build:sidecar": "bash scripts/build-sidecar.sh",
    "build:desktop": "bash scripts/build-desktop.sh",
    "release:desktop": "bash scripts/release-desktop.sh",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck --filter=!@mpt/desktop",
    "web": "pnpm --filter @mpt/web dev",
    "landing": "pnpm --filter @mpt/landing dev",
    "desktop": "pnpm --filter @mpt/desktop dev"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
