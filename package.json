{
  "name": "moneyprinter-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@mpt/web",
    "build": "turbo run build --filter=!@mpt/desktop",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck --filter=!@mpt/desktop",
    "web": "pnpm --filter @mpt/web dev",
    "desktop": "pnpm --filter @mpt/desktop dev"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
